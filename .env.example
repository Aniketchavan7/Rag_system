# LLM Settings (OpenAI-compatible, e.g. xKiro, Groq, or OpenAI)
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=qwen/qwen3.5-flash:free

# Embeddings (defaults to local HuggingFace / sentence-transformers, 0 cost, fast CPU)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Vector Store: "pinecone" or "chroma"
# If PINECONE_API_KEY is empty, it automatically falls back to local ChromaDB
VECTOR_STORE_TYPE=chroma
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentic-ai-index
PINECONE_ENVIRONMENT=us-east-1

# Knowledge Base Document
PDF_FILE_PATH=Knowlegde_base/Ebook-Agentic-AI.pdf

# RAG Settings
TOP_K=4
CHUNK_SIZE=700
CHUNK_OVERLAP=100
CONFIDENCE_THRESHOLD=0.45
